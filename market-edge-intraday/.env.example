# =============================================================================
# market-edge-intraday — example environment configuration
# Copy this file to ".env" and fill in the values you have.
# The system runs with ZERO real money. It never connects a real broker
# account and never sends real orders. It only needs READ-ONLY market data.
# =============================================================================

# -----------------------------------------------------------------------------
# MARKET DATA PROVIDER
# -----------------------------------------------------------------------------
# Which data source to use for live intraday bars: "alpaca" or "massive".
# Without a valid key the system will NOT invent data — it refuses to trade
# and only unit tests (which use bundled fixture data) will run.
MARKET_DATA_PROVIDER=alpaca

# --- Alpaca Market Data API (recommended primary, free tier available) ------
# How to get a key (see README section "How to get an API key"):
#   1. Create a free account at https://alpaca.markets
#   2. Open the dashboard, go to "Paper Trading" -> "API Keys"
#   3. Generate a key, paste the two values below.
# The free "iex" feed is enough for this research system.
ALPACA_API_KEY=
ALPACA_SECRET_KEY=
ALPACA_DATA_FEED=iex
ALPACA_BASE_URL=https://data.alpaca.markets

# --- Massive / Polygon API (optional alternative) ---------------------------
MASSIVE_API_KEY=
MASSIVE_BASE_URL=https://api.polygon.io

# -----------------------------------------------------------------------------
# DATABASE (PostgreSQL). Times are stored in UTC.
# -----------------------------------------------------------------------------
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=intraday
POSTGRES_USER=intraday
POSTGRES_PASSWORD=change_me_in_production
# Optional full override; if set, takes priority over the parts above.
# DATABASE_URL=postgresql+psycopg://intraday:change_me@postgres:5432/intraday

# Local file stores for historical bars and fast analytics.
PARQUET_DIR=data/cache
DUCKDB_PATH=data/cache/intraday.duckdb

# -----------------------------------------------------------------------------
# CAPITAL & CURRENCY
# -----------------------------------------------------------------------------
INITIAL_CAPITAL_PLN=1000000
# USD/PLN is fetched daily; this is the fallback if the FX lookup fails.
FALLBACK_USDPLN=4.0

# -----------------------------------------------------------------------------
# SESSION TIMING (America/New_York). DB stores UTC.
# -----------------------------------------------------------------------------
LAST_NEW_ENTRY_TIME_ET=15:15
FORCE_CLOSE_START_ET=15:45
FORCE_CLOSE_DEADLINE_ET=15:50
BAR_INTERVAL=15Min

# Block trading if the latest bar is older than this many seconds.
MAX_DATA_STALENESS_SECONDS=1200

# -----------------------------------------------------------------------------
# UNIVERSE FILTERS
# -----------------------------------------------------------------------------
UNIVERSE_TARGET_SIZE=500
MIN_PRICE_USD=5
MAX_PRICE_USD=1000
MIN_AVG_DAILY_VOLUME=1000000
MIN_AVG_DOLLAR_VOLUME_USD=25000000
MIN_HISTORY_DAYS=100

# -----------------------------------------------------------------------------
# SCORING / SIGNALS
# -----------------------------------------------------------------------------
MIN_SIGNAL_SCORE=75

# -----------------------------------------------------------------------------
# RISK MANAGEMENT
# -----------------------------------------------------------------------------
RISK_PER_TRADE_PCT=0.001
MAX_POSITION_VALUE_PLN=30000
MAX_OPEN_POSITIONS=20
MAX_GROSS_EXPOSURE_PCT=0.50
MAX_SECTOR_EXPOSURE_PCT=0.15
MAX_POSITIONS_PER_SECTOR=3
MAX_TOTAL_OPEN_RISK_PCT=0.02
MAX_DAILY_LOSS_PCT=0.01
MAX_STRATEGY_DAILY_LOSS_PCT=0.004
MAX_CONSECUTIVE_LOSSES=8

# -----------------------------------------------------------------------------
# EXECUTION / COSTS
# -----------------------------------------------------------------------------
# Cost scenario: LOW | BASE | STRESS (see README "Cost scenarios").
COST_SCENARIO=BASE
# Max share of a 15-minute bar's traded value a single fill may consume.
MAX_POSITION_BAR_VOLUME_PCT=0.01

# -----------------------------------------------------------------------------
# STRATEGY-SPECIFIC
# -----------------------------------------------------------------------------
ORB_MAX_STOP_PCT=0.025
# Comma-separated list of enabled strategies (empty = all enabled).
ENABLED_STRATEGIES=OPENING_RANGE_BREAKOUT,VWAP_MEAN_REVERSION,RELATIVE_STRENGTH_MOMENTUM,VOLUME_EXPANSION_MOMENTUM

# -----------------------------------------------------------------------------
# ALERTS (all optional — leave blank to disable)
# -----------------------------------------------------------------------------
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
SLACK_WEBHOOK_URL=

# -----------------------------------------------------------------------------
# MISC
# -----------------------------------------------------------------------------
LOG_LEVEL=INFO
TZ=UTC
BENCHMARK_SYMBOL=SPY
