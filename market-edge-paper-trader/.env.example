# Swing engine
INITIAL_CAPITAL_PLN=1000000
PLN_USD_RATE=4.00
RISK_PER_TRADE_PCT=0.005
MAX_POSITION_SIZE_PCT=0.03
MAX_OPEN_POSITIONS=40
