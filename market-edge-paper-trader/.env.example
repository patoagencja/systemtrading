PROFIT_LOCK_TRIGGER_2_PCT=0.08
PROFIT_LOCK_LEVEL_2_PCT=0.04
PROFIT_LOCK_TRIGGER_3_PCT=0.10
PROFIT_LOCK_LEVEL_3_PCT=0.07
