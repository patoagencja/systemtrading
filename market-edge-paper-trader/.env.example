INTRADAY_MIN_SCORE=75
INTRADAY_MIN_PRICE_USD=10
INTRADAY_MIN_AVG_DAILY_VOLUME=1000000
INTRADAY_MIN_AVG_DOLLAR_VOLUME_USD=50000000

INTRADAY_FIRST_ENTRY_TIME_ET=10:00
INTRADAY_LAST_ENTRY_TIME_ET=14:30
