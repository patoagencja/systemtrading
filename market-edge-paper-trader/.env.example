TRAILING_STOP_DISTANCE_PCT=0.03
DEFAULT_MAX_HOLDING_SESSIONS=10
MAX_WINNER_EXTENSION_SESSIONS=5
ENABLE_TECHNICAL_EXIT=false
ENABLE_PARTIAL_EXITS=false

# Intraday engine
INTRADAY_ENABLED=true
INTRADAY_INITIAL_CAPITAL_PLN=1000000
